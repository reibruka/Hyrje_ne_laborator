```python
import json

data = {
    "title": "Conda (Miniconda) Guide",
    "author": "Rei Bruka",
    "date": "17-03-2026",
    "introduction": {
        "what_is_miniconda": "Miniconda is a free, minimal bootstrap installer for Conda. It is a small, lightweight version of Anaconda that includes only conda, Python, the packages they depend on, and a small number of other useful packages, including pip, zlib and a few others.",
        "why_use_conda_environments": [
            "Isolation: Avoids dependency conflicts between different projects by keeping their packages separate.",
            "Versatility: Allows you to install different versions of Python (e.g., Python 3.8 in one environment and Python 3.11 in another) on the same machine.",
            "Reproducibility: Easily share your exact package environment with others via environment files, ensuring code runs identically across machines.",
            "Cross-Platform: Conda is package-agnostic and manages binaries, making it excellent for data science and machine learning libraries that require non-Python dependencies."
        ]
    },
    "basic_concepts": [
        {
            "term": "Conda",
            "definition": "An open-source package management system and environment management system that runs on Windows, macOS, and Linux."
        },
        {
            "term": "Environment",
            "definition": "An isolated directory where a specific set of packages and dependencies are installed, preventing interference with other projects."
        },
        {
            "term": "Channel",
            "definition": "Locations (URLs) where Conda looks for packages. Examples include 'defaults' and 'conda-forge'."
        }
    ],
    "installation_guide": {
        "steps": [
            {
                "step_number": 1,
                "action": "Download the Installer",
                "details": "Go to the official Miniconda website (https://docs.conda.io/en/latest/miniconda.html) and download the installer appropriate for your operating system (Windows, macOS, or Linux)."
            },
            {
                "step_number": 2,
                "action": "Run the Installer",
                "details": "Follow the installation prompts. For Windows, run the .exe file. For macOS/Linux, run the shell script in your terminal using 'bash Miniconda3-latest-Linux-x86_64.sh'."
            },
            {
                "step_number": 3,
                "action": "Initialize Conda",
                "details": "During installation, opt to run 'conda init' or manually run it after installation to configure your shell."
            },
            {
                "step_number": 4,
                "action": "Verify Installation",
                "details": "Open a new terminal window and type 'conda --version' to confirm that it has been installed successfully."
            }
        ]
    },
    "basic_commands": {
        "create_environment": "conda create --name myenv python=3.10",
        "activate_environment": "conda activate myenv",
        "install_package": "conda install numpy",
        "list_environments": "conda env list",
        "deactivate_environment": "conda deactivate"
    }
}

file_path = "miniconda_guide.json"
with open(file_path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=4)

print(f"File successfully created: {file_path}")



